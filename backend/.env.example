# Copy this file to .env and fill in the values before running the server.
# Never commit the actual .env file to version control.

DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=replace-this-with-a-long-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Email (development uses console backend — no SMTP needed)
DEFAULT_FROM_EMAIL=noreply@ercms.local

# ── Production-only variables (not needed for development) ───────────────────
# DB_NAME=ercms_db
# DB_USER=ercms_user
# DB_PASSWORD=strong-db-password
# DB_HOST=localhost
# DB_PORT=5432
#
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-smtp-user
# EMAIL_HOST_PASSWORD=your-smtp-password
# EMAIL_USE_TLS=True
#
# CORS_ALLOWED_ORIGINS=https://yourfrontend.com
# CSRF_TRUSTED_ORIGINS=https://yourfrontend.com
